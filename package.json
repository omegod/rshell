{
  "name": "rshell",
  "version": "1.0.0",
  "description": "A remote shell tool with file browser and terminal",
  "main": "./out/main/main.js",
  "type": "module",
  "author": "caichenghu",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/omegod/rshell.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package:mac": "pnpm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "package:mac:signed": "pnpm run build && electron-builder --mac --arm64",
    "package:win": "pnpm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.1",
    "@uiw/react-codemirror": "^4.25.9",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^5.20.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.caichenghu.rshell",
    "productName": "RShell",
    "npmRebuild": false,
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleScriptEnabled": false
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  }
}
